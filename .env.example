# Copy to .env for local development. On Render, set these under Environment instead.
# .env is git-ignored; never put real values in this file.

# Where inquiry emails go (comma-separate multiple addresses).
MAIL_TO=

# The Microsoft 365 mailbox inquiries are sent from (a licensed user or shared mailbox
# in your tenant). Just the address, e.g. inquiries@yourdomain.com.
MAIL_FROM=

# Entra ID (Azure AD) app registration. The app needs the Microsoft Graph *application*
# permission Mail.Send, with admin consent granted.
# Tenant ID and Application (client) ID are on the app's Overview page.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# From Certificates & secrets: the secret's Value (shown only once), not its Secret ID.
AZURE_CLIENT_SECRET=

# Sites allowed to call /api/inquiry, comma-separated. Only matters if index.html is
# hosted somewhere other than this Flask app. "*" allows any site.
CORS_ORIGINS=*
